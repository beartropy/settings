{
    "name": "beartropy/settings",
    "description": "Dynamic settings management for Laravel with Livewire UI",
    "type": "library",
    "version": "1.0.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Beartropy",
            "email": "beartropy@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "livewire/livewire": "^3.0",
        "beartropy/ui": "*",
        "beartropy/tables": "*"
    },
    "autoload": {
        "psr-4": {
            "Beartropy\\Settings\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Beartropy\\Settings\\BeartropySettingsServiceProvider"
            ],
            "aliases": {
                "BeartropySettings": "Beartropy\\Settings\\Facades\\BeartropySettings"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}